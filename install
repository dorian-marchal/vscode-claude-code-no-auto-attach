#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

VERSION="$(node -p "require('./package.json').version")"
VSIX="dist/claude-code-no-auto-attach-${VERSION}.vsix"

mkdir -p dist

echo "==> Packaging $VSIX"
npx --yes @vscode/vsce package --out "$VSIX" >/dev/null

echo "==> Installing into VS Code"
code --install-extension "$VSIX" --force

echo
echo "Done. Reload your VS Code window to activate the patch."
